<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1E293B">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚨 VitalPass 의료 카드"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/widget_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="이름: 미등록"
        android:textColor="#E2E8F0"
        android:textSize="12sp"
        android:layout_marginBottom="3dp"/>

    <TextView
        android:id="@+id/widget_blood"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="혈액형: 미등록"
        android:textColor="#E2E8F0"
        android:textSize="12sp"
        android:layout_marginBottom="3dp"/>

    <TextView
        android:id="@+id/widget_contact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="비상연락: 미등록"
        android:textColor="#FCA5A5"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#BA1A1A"
        android:textColor="#FFFFFF"
        android:text="터치하여 패스 열기"
        android:gravity="center"
        android:padding="6dp"
        android:textSize="11sp"
        android:textStyle="bold"/>
</LinearLayout>
